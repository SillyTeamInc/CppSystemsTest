function(_embed_resources_write path content)
    cmake_path(GET path PARENT_PATH _dir)
    file(MAKE_DIRECTORY "${_dir}")
    file(WRITE "${path}.new" "${content}")
    file(COPY_FILE "${path}.new" "${path}" ONLY_IF_DIFFERENT)
    file(REMOVE "${path}.new")
endfunction()


function(embed_resources target)
    if (CMAKE_VERSION VERSION_LESS 3.21)
        message(FATAL_ERROR "embed_resources requires cmake 3.21 or newer")
    endif ()

    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "DIRECTORY;NAMESPACE;HEADER;BACKEND;LD;OBJCOPY" "EXCLUDE")

    if (NOT TARGET ${target})
        message(FATAL_ERROR "[embed_resources] ${target} is not a known cmake target")
    endif ()

    if (NOT ARG_DIRECTORY)
        set(ARG_DIRECTORY resources)
    endif ()
    cmake_path(ABSOLUTE_PATH ARG_DIRECTORY BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
    if (NOT IS_DIRECTORY "${ARG_DIRECTORY}")
        message(FATAL_ERROR "[embed_resources] resource directory ${ARG_DIRECTORY} doesnt exist")
    endif ()

    if (NOT ARG_NAMESPACE)
        set(ARG_NAMESPACE embedded)
    endif ()
    if (NOT ARG_HEADER)
        set(ARG_HEADER embedded/resources.hpp)
    endif ()

    if (NOT ARG_BACKEND)
        set(ARG_BACKEND ld)
    endif ()
    string(TOLOWER "${ARG_BACKEND}" backend)
    if (NOT backend STREQUAL "ld")
        message(FATAL_ERROR "[embed_resources] ${ARG_BACKEND} is not a supported backend, use ld")
    endif ()

    set(ld_program)
    set(objcopy_program)
    if (ARG_LD)
        find_program(ld_program NAMES "${ARG_LD}" NO_CACHE)
        if (NOT ld_program)
            message(FATAL_ERROR "[embed_resources] could not find LD ${ARG_LD}")
        endif ()
    else ()
        find_program(EMBED_RESOURCES_LD NAMES x86_64-w64-mingw32-ld)
        set(ld_program "${EMBED_RESOURCES_LD}")
        if (NOT ld_program)
            message(FATAL_ERROR "[embed_resources] couldn't find x86_64-w64-mingw32-ld, install mingw binutils or pass LD <path>")
        endif ()
    endif ()

    if (ARG_OBJCOPY)
        find_program(objcopy_program NAMES "${ARG_OBJCOPY}" NO_CACHE)
        if (NOT objcopy_program)
            message(FATAL_ERROR "[embed_resources] could not find objcopy (${ARG_OBJCOPY})")
        endif ()
    else ()
        cmake_path(GET ld_program PARENT_PATH ld_dir)
        find_program(EMBED_RESOURCES_OBJCOPY NAMES x86_64-w64-mingw32-objcopy HINTS "${ld_dir}")
        set(objcopy_program "${EMBED_RESOURCES_OBJCOPY}")
    endif ()
    if (NOT objcopy_program)
        message(WARNING "[embed_resources] objcopy wasn't found! embedded data will be writable in .data")
    endif ()

    cmake_path(GET ARG_HEADER PARENT_PATH header_dir)
    cmake_path(GET ARG_HEADER STEM header_stem)
    cmake_path(GET ARG_HEADER EXTENSION header_ext)
    if (header_dir)
        set(blob_header "${header_dir}/${header_stem}_blob${header_ext}")
    else ()
        set(blob_header "${header_stem}_blob${header_ext}")
    endif ()

    set(generator "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    set(gen_root "${CMAKE_CURRENT_BINARY_DIR}/embedded_resources/${target}")
    set(include_dir "${gen_root}/include")
    set(source_dir "${gen_root}/src")
    set(object_dir "${gen_root}/obj")

    file(GLOB_RECURSE files CONFIGURE_DEPENDS LIST_DIRECTORIES false
            RELATIVE "${ARG_DIRECTORY}" "${ARG_DIRECTORY}/*")
    list(FILTER files EXCLUDE REGEX "(^|/)\\.")
    foreach (pattern IN LISTS ARG_EXCLUDE)
        list(FILTER files EXCLUDE REGEX "${pattern}")
    endforeach ()
    list(SORT files)

    set(idents)
    set(sources)
    set(objects)
    set(declarations)
    set(table)

    foreach (rel IN LISTS files)
        string(MAKE_C_IDENTIFIER "${rel}" ident)

        if (ident IN_LIST idents)
            message(FATAL_ERROR "[embed_resources] ${rel} produces the same identifier ${ident} as another file")
        endif ()
        list(APPEND idents "${ident}")

        string(APPEND declarations "extern const blob ${ident};\n")
        string(APPEND table "    &${ident},\n")

        set(source "${source_dir}/${ident}.cpp")
        list(APPEND sources "${source}")

        if (rel MATCHES "[^ -~]")
            message(FATAL_ERROR "[embed_resources] ${rel} contains non-ASCII characters! "
                    "The ld backend builds symbol names from file names so you must only use ASCII characters!!")
        endif ()

        string(REGEX REPLACE "[^A-Za-z0-9_]" "_" ld_name "${rel}")
        set(object "${object_dir}/${ident}.o")
        list(APPEND objects "${object}")

        string(JOIN "" source_text
                "// This file was generated by CMake. Do not edit it manually. ${rel}\n"
                "#include <${blob_header}>\n"
                "\n"
                "extern \"C\" {\n"
                "extern const unsigned char _binary_${ld_name}_start[];\n"
                "extern const unsigned char _binary_${ld_name}_end[];\n"
                "}\n"
                "\n"
                "namespace ${ARG_NAMESPACE} {\n"
                "\n"
                "extern const blob ${ident};\n"
                "const blob ${ident}{_binary_${ld_name}_start, _binary_${ld_name}_end, \"${rel}\"};\n"
                "\n"
                "}\n")
        _embed_resources_write("${source}" "${source_text}")

        set(commands COMMAND "${ld_program}" -r -b binary -o "${object}" "${rel}")
        if (objcopy_program)
            list(APPEND commands
                    COMMAND "${objcopy_program}" --rename-section ".data=.rdata,alloc,load,readonly,data,contents" "${object}")
        endif ()
        file(MAKE_DIRECTORY "${object_dir}")
        add_custom_command(
                OUTPUT "${object}"
                ${commands}
                DEPENDS "${ARG_DIRECTORY}/${rel}"
                WORKING_DIRECTORY "${ARG_DIRECTORY}"
                COMMENT "Embedding resource ${rel}"
                VERBATIM)
    endforeach ()

    list(LENGTH files count)

    set(blob_header_text "// This file was generated by CMake. Do not edit it manually.
#pragma once

#include <cstddef>
#include <span>
#include <string_view>

namespace ${ARG_NAMESPACE} {

class blob {
public:
    constexpr blob(const unsigned char* begin, const unsigned char* end, const char* path) noexcept
        : m_begin(begin), m_end(end), m_path(path) {}

    [[nodiscard]] constexpr const unsigned char* data() const noexcept { return m_begin; }
    [[nodiscard]] constexpr std::size_t size() const noexcept { return static_cast<std::size_t>(m_end - m_begin); }
    [[nodiscard]] constexpr bool empty() const noexcept { return m_begin == m_end; }
    [[nodiscard]] constexpr std::string_view path() const noexcept { return m_path; }

    [[nodiscard]] std::span<const std::byte> bytes() const noexcept {
        return {reinterpret_cast<const std::byte*>(m_begin), size()};
    }

    [[nodiscard]] std::string_view text() const noexcept {
        return {reinterpret_cast<const char*>(m_begin), size()};
    }
private:
    const unsigned char* m_begin;
    const unsigned char* m_end;
    const char* m_path;
};

}
")

    set(header "// This file was generated by CMake. Do not edit it manually.
#pragma once

#include <${blob_header}>

namespace ${ARG_NAMESPACE} {

${declarations}
[[nodiscard]] std::span<const blob* const> all() noexcept;

[[nodiscard]] const blob* find(std::string_view path) noexcept;

}
")

    if (count EQUAL 0)
        set(table_body "    nullptr,\n")
    else ()
        set(table_body "${table}")
    endif ()

    set(index "// This file was generated by CMake. Do not edit it manually.
#include <${ARG_HEADER}>

#include <algorithm>
#include <iterator>

namespace ${ARG_NAMESPACE} {
namespace {

constexpr std::size_t count = ${count};

const blob* const table[] = {
${table_body}};

}

std::span<const blob* const> all() noexcept {
    return {table, count};
}

const blob* find(std::string_view path) noexcept {
    const auto end = std::begin(table) + count;
    const auto it = std::lower_bound(std::begin(table), end, path,
        [](const blob* entry, std::string_view value) { return entry->path() < value; });
    return it != end && (*it)->path() == path ? *it : nullptr;
}

}
")

    set(header_path "${include_dir}/${ARG_HEADER}")
    set(blob_header_path "${include_dir}/${blob_header}")
    set(index_path "${source_dir}/index.cpp")
    _embed_resources_write("${blob_header_path}" "${blob_header_text}")
    _embed_resources_write("${header_path}" "${header}")
    _embed_resources_write("${index_path}" "${index}")

    set_source_files_properties(${sources} "${index_path}" PROPERTIES
            SKIP_UNITY_BUILD_INCLUSION ON
            SKIP_PRECOMPILE_HEADERS ON)
    if (objects)
        set_source_files_properties(${objects} PROPERTIES EXTERNAL_OBJECT ON GENERATED ON)
    endif ()

    target_sources(${target} PRIVATE ${sources} ${objects} "${index_path}")
    target_include_directories(${target} PRIVATE "${include_dir}")

    message(STATUS "[embed_resources(${target})] embedded ${count} resource(s) from ${ARG_DIRECTORY} using the ${backend} backend")
endfunction()